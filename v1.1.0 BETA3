using System;
using System.IO;
using System.Net.Http;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace WorldBoxModLoader
{
    public class ModLoader
    {
        private static readonly HttpClient httpClient = new HttpClient();

        public async Task DownloadModAsync(string modUrl, string destinationPath)
        {
            try
            {
                var response = await httpClient.GetAsync(modUrl);
                response.EnsureSuccessStatusCode();

                var modData = await response.Content.ReadAsByteArrayAsync();
                File.WriteAllBytes(destinationPath, modData);
                MessageBox.Show("Mod downloaded successfully!", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error downloading mod: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        public void LoadMod(string modPath)
        {
            if (File.Exists(modPath))
            {
                // Logic to load the mod into WorldBox
                MessageBox.Show("Mod loaded successfully!", "Success", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            else
            {
                MessageBox.Show("Mod file not found!", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
    }

    public class Program
    {
        [STAThread]
        static void Main()
        {
            Application.EnableVisualStyles();
            Application.SetCompatibleTextRenderingDefault(false);

            var modLoader = new ModLoader();
            string modUrl = "https://example.com/path/to/mod.zip"; // Replace with actual mod URL
            string destinationPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "WorldBoxMods", "mod.zip");

            Task.Run(() => modLoader.DownloadModAsync(modUrl, destinationPath)).Wait();
            modLoader.LoadMod(destinationPath);
        }
    }
}
using System;
using System.IO;
using System.Reflection;
using System.Collections.Generic;

public class ModLoader
{
    private static List<Assembly> loadedMods = new List<Assembly>();

    public static void LoadMods(string modDirectory)
    {
        // Проверяем, существует ли директория с модами
        if (!Directory.Exists(modDirectory))
        {
            Console.WriteLine("Директория модов не найдена: " + modDirectory);
            return;
        }

        // Получаем список файлов .dll в директории
        string[] modFiles = Directory.GetFiles(modDirectory, "*.dll");

        foreach (string modFile in modFiles)
        {
            try
            {
                // Загружаем сборку
                Assembly modAssembly = Assembly.LoadFrom(modFile);
                loadedMods.Add(modAssembly);

                // Ищем классы, реализующие интерфейс IMod (предположим, он существует)
                foreach (Type type in modAssembly.GetTypes())
                {
                    if (typeof(IMod).IsAssignableFrom(type) && !type.IsInterface && !type.IsAbstract)
                    {
                        // Создаем экземпляр класса мода
                        IMod modInstance = (IMod)Activator.CreateInstance(type);

                        // Вызываем метод Initialize у мода
                        modInstance.Initialize();

                        Console.WriteLine("Мод загружен: " + type.Name);
                    }
                }
            }
            catch (Exception e)
            {
                Console.WriteLine("Ошибка при загрузке мода " + modFile + ": " + e.Message);
            }
        }
    }

    // Другие методы для управления модами (например, выгрузка, включение/выключение)
}

