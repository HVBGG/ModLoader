        }

        string[] modFiles = Directory.GetFiles(modsDirectory, "*.dll"); // Ищем .dll файлы

        foreach (string modFile in modFiles)
        {
            try
            {
                Assembly modAssembly = Assembly.LoadFrom(modFile); // Загружаем сборку

                // Дополнительная логика для проверки "длинного кода" идентификации мода
                // (предположим, что он содержится в атрибуте или манифесте)

                // Запуск мода (предположим, что он реализует интерфейс или имеет точку входа)
                Type modType = modAssembly.GetType("MyMod.EntryPoint"); // Пример точки входа
                if (modType != null)
                {
                    MethodInfo initializeMethod = modType.GetMethod("Initialize");
                    if (initializeMethod != null)
                    {
                        object instance = Activator.CreateInstance(modType);
                        initializeMethod.Invoke(instance, null);
                    }
                }
            }
